# MongoDB connection string (data ingestion source, matches upload_data_mongodb.py)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# AWS credentials (optional, used only if syncing the model registry to S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
MODEL_REGISTRY_BUCKET=

# Flask
FLASK_SECRET_KEY=change-me-in-production
